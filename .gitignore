# ==========================================
# PeerLearn - .gitignore
# Student Skill Exchange Platform
# ==========================================

# Compiled Java & Maven build artifacts
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Node / Frontend build artifacts
node_modules/
build/
dist/
coverage/
.next/
.turbo/

# Logs and runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secrets (Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
secrets/
*.pem
*.key
*.p12
*.jks

# IDE & Editor files
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans

# Operating System temporary files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Local database files
*.sqlite
*.sqlite3
*.db
*.dump

# Maven crash & diagnostics logs
hs_err_pid*
replay_pid*

# Keep Maven Wrapper and DevOps files
!.mvn/wrapper/maven-wrapper.jar
!mvnw
!mvnw.cmd
!Dockerfile
!Jenkinsfile
!k8s/
